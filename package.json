{
  "name": "axion",
  "version": "1.1.4",
  "description": "Professional desktop AI image editor powered by Google's Gemini 3.1 Flash Image (Nano Banana 2)",
  "main": "src/main/main.js",
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "dotenv": "^17.4.2",
    "heic-convert": "^2.1.0"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.axion.app",
    "productName": "AXION",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "ui/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/icon.ico"
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "protobufjs@7.6.5": true,
    "@google/genai@2.15.0": true
  }
}
